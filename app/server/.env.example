# サーバーの設定ファイルの見本です。
# このファイルを同じフォルダに .env という名前でコピーし、値を書き換えて使ってください。
#   cp .env.example .env
# .env は .gitignore で除外しているので、GitHub には上がりません。

# サーバーが待ち受けるポート番号
PORT=3001

# データ（SQLite のデータベースとレシート画像）を置くフォルダ。省略時は app/data
# DATA_DIR=/path/to/data

# レシート読み取りに使う AI。gemini（既定）か claude
AI_PROVIDER=gemini

# Gemini API のキー（AI_PROVIDER=gemini のとき）。https://aistudio.google.com で無料で発行できる。
# 支払い方法を登録しないキーは無料枠になる（回数制限あり。送った内容は Google の製品改善に使われる）
GEMINI_API_KEY=

# 最初に使う Gemini のモデル。省略時は gemini-3.8-flash。
# そのモデルが混雑中・回数上限のときは、自動で gemini-3.5-flash-lite でやり直す
# GEMINI_MODEL=gemini-3.8-flash

# Claude API のキー（AI_PROVIDER=claude のとき。有料）。https://platform.claude.com で発行する
ANTHROPIC_API_KEY=

# LINE Messaging API のチャネルアクセストークン（月次レポートの送信に使用）。
# LINE Developers コンソールで公式アカウントのチャネルを作り、「長期のチャネルアクセストークン」を発行する。
# 空のままなら LINE 送信は行わない。
LINE_CHANNEL_ACCESS_TOKEN=

# ログイン状態を保つクッキーを HTTPS 接続のときだけ送るか。
# インターネットに公開して HTTPS で使うときは true にする。
COOKIE_SECURE=false
