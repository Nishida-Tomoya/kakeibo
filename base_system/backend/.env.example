# バックエンドの設定ファイルの見本です。
# このファイルを同じフォルダに .env.local という名前でコピーし、値を書き換えて使ってください。
#   cp .env.example .env.local
# .env.local は .gitignore で除外しているので、GitHub には上がりません。

# バックエンドサーバーが待ち受けるホスト。
# 127.0.0.1（この PC からだけ接続できる）のままにしておくのが安全です。
API_BACKEND_HOST=127.0.0.1

# バックエンドサーバーが待ち受けるポート番号
API_BACKEND_PORT=5000

# バックエンドが受け付けるリクエストの最大サイズ（レシート画像などを含む）
API_PAYLOAD_MAX_SIZE=5mb

# Google Cloud のリージョン（例：us-central1）
GOOGLE_CLOUD_LOCATION=your-region

# Google Cloud のプロジェクト ID
GOOGLE_CLOUD_PROJECT=your-project-id

# フロントエンドからの通信であることを確認するための合言葉。
# frontend/vertex-ai-proxy-interceptor.js の 'X-App-Proxy' に書かれている値と同じ文字列にしてください。
# 違う値にすると、バックエンドがフロントエンドからのリクエストを拒否します。
PROXY_HEADER=same-value-as-X-App-Proxy-in-frontend
